{
  "name": "filehound",
  "version": "2.0.0",
  "description": "Find files the easy way",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs": "typedoc",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -fr dist/*",
    "prepublish": "npm run build",
    "prepublishOnly": "tsc -p ./ --outDir dist",
    "test": "mocha -r ts-node/register test/*.ts",
    "posttest": "npm run lint",
    "lint": "eslint src",
    "coverage": "nyc mocha && nyc report --reporter=html && nyc report --reporter=json-summary"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nspragg/filehound.git"
  },
  "keywords": [
    "file",
    "recursive",
    "search",
    "filehound",
    "file",
    "hound",
    "lister",
    "find",
    "directory",
    "walk",
    "walker",
    "promise",
    "finder",
    "fs",
    "file system"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nspragg/filehound/issues"
  },
  "homepage": "https://github.com/nspragg/filehound",
  "nyc": {
    "include": [
      "src/**/*.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "minimatch": "^3.0.3",
    "unit-compare": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^4.1.2",
    "eslint": "^10.13.0",
    "istanbul": "1.1.0-alpha.1",
    "mocha": "^5.0.5",
    "moment": "^2.25.3",
    "sinon": "^4.5.0",
    "ts-node": "^8.10.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1"
  }
}
